OPENAI_API_KEY=your_key
OPENAI_MODEL=gpt-5.6

SMTP_HOST=smtp.your-company.example
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
